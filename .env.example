# Copy this file to .env and fill in your local values.
# The .env file is ignored by git.

# Backend
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_BASE_URL=https://api.openai.com

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/little_moments
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.ngrok-free.app
N8N_WEBHOOK_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_API_KEY=
N8N_WEBHOOK_DEFAULT_LANGUAGE=en
N8N_WEBHOOK_TIMEOUT_MS=5000

# Frontend (Vite)
# Required for Supabase-first MVP.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional locally (defaults to /api), required for separate frontend/backend deploys.
VITE_API_URL=
